#include <stdio.h>

int main()
{
    int n, bt[10], pr[10], rt[10];
    int i, time = 0, completed = 0, highest;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("Burst Time P%d: ", i + 1);
        scanf("%d", &bt[i]);

        printf("Priority P%d: ", i + 1);
        scanf("%d", &pr[i]);

        rt[i] = bt[i];
    }

    while(completed != n)
    {
        highest = -1;

        for(i = 0; i < n; i++)
        {
            if(rt[i] > 0)
            {
                if(highest == -1 || pr[i] < pr[highest])
                    highest = i;
            }
        }

        rt[highest]--;
        time++;

        if(rt[highest] == 0)
            completed++;
    }

    printf("Processes completed successfully.\n");

    return 0;
}
