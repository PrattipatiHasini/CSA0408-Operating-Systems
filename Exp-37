#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n, head, req[20];
    int seek = 0;

    printf("Enter Number of Requests: ");
    scanf("%d", &n);

    for(int i = 0; i < n; i++)
        scanf("%d", &req[i]);

    printf("Enter Initial Head Position: ");
    scanf("%d", &head);

    for(int i = 0; i < n; i++)
    {
        seek += abs(req[i] - head);
        head = req[i];
    }

    printf("Total Seek Time = %d\n", seek);

    return 0;
}
