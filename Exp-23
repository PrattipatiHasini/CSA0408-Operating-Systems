#include <stdio.h>

int main()
{
    int blockSize[] = {100, 500, 200, 300, 600};
    int processSize[] = {212, 417, 112, 426};
    int allocation[4];
    int i, j;

    for(i = 0; i < 4; i++)
        allocation[i] = -1;

    for(i = 0; i < 4; i++)
    {
        for(j = 0; j < 5; j++)
        {
            if(blockSize[j] >= processSize[i])
            {
                allocation[i] = j;
                blockSize[j] -= processSize[i];
                break;
            }
        }
    }

    printf("Process\tBlock\n");
    for(i = 0; i < 4; i++)
        printf("%d\t%d\n", i+1, allocation[i]+1);

    return 0;
}
