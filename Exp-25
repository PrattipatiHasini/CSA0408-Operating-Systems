#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main()
{
    int fd;
    struct stat fileStat;
    DIR *dir;
    struct dirent *entry;

    fd = open("sample.txt", O_RDONLY);

    lseek(fd, 0, SEEK_SET);

    fstat(fd, &fileStat);

    printf("File Size: %ld bytes\n", fileStat.st_size);

    dir = opendir(".");

    printf("\nDirectory Contents:\n");

    while((entry = readdir(dir)) != NULL)
        printf("%s\n", entry->d_name);

    closedir(dir);
    close(fd);

    return 0;
}
