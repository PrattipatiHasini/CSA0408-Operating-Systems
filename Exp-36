#include <stdio.h>

int main()
{
    int n, block;

    printf("Enter Number of Blocks: ");
    scanf("%d", &n);

    printf("Enter Starting Block: ");
    scanf("%d", &block);

    printf("Linked Allocation:\n");

    for(int i = 1; i <= n; i++)
    {
        printf("%d", block);

        if(i != n)
        {
            int next;
            printf(" -> ");
            scanf("%d", &next);
            block = next;
        }
    }

    return 0;
}
